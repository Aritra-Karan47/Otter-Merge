# Neon: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Layerbase Redis-compatible endpoint (use rediss:// for TLS)
LAYERBASE_URL=rediss://default:password@your-instance.layerbase.example:6379
# Random secret; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-to-a-long-random-string
# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=